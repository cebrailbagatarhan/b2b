DATABASE_URL="sqlserver://localhost:1433;database=ToptanB2B;user=YOUR_USER;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"
# Generate a unique secret; the placeholder below is intentionally rejected.
SESSION_SECRET="GENERATE_A_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS"

# Public site URL used in password-reset emails
APP_URL="http://127.0.0.1:3100"

# SMTP is required for production password-reset delivery. Without it,
# production logs only a generic failure; local/dev may preview the reset link.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="TopTan Market <noreply@toptanmarket.com>"

# Production registration intentionally fails closed until a real, one-time
# SMS verification provider replaces the development-only demo code.

# Destructive demo seed stays disabled unless explicitly enabled locally.
ALLOW_DEMO_SEED="false"
SEED_ADMIN_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""
